{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HomeProxy",
  "version": "1.3.0",
  "identifier": "cz.klidnasit.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "HomeProxy",
        "width": 1180,
        "height": 760,
        "minWidth": 760,
        "minHeight": 620,
        "center": true,
        "visible": false,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "capabilities": [
        "main"
      ],
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self'; script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.png",
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "targets": [
      "nsis"
    ],
    "category": "Utility",
    "shortDescription": "Klidná domácí proxy pro Windows 11",
    "longDescription": "Lokální HTTP a SOCKS5 proxy pro Windows: přehled provozu, limity zařízení, více LAN adres a volitelná kontrola HTTPS s veřejnou cache a kompresí obrázků.",
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "./windows/hooks.nsh",
        "languages": [
          "English",
          "Czech"
        ],
        "customLanguageFiles": {
          "Czech": "./windows/Czech.nsh"
        }
      }
    }
  }
}
