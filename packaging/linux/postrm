#!/bin/sh
set -e

case "$1" in
    remove)
        if command -v systemctl >/dev/null 2>&1; then
            systemctl daemon-reload || true
        fi
        if command -v deb-systemd-helper >/dev/null 2>&1; then
            deb-systemd-helper mask homeproxy.service >/dev/null || true
        fi
        ;;
    purge)
        if command -v systemctl >/dev/null 2>&1; then
            systemctl daemon-reload || true
        fi
        if command -v deb-systemd-helper >/dev/null 2>&1; then
            deb-systemd-helper purge homeproxy.service >/dev/null || true
            deb-systemd-helper unmask homeproxy.service >/dev/null || true
        fi
        ;;
esac

# State/cache and the service identity are intentionally retained for safe reinstallation.
exit 0
